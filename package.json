{
  "name": "isometric-san-francisco",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4186",
    "test": "node --experimental-strip-types --test src/model.test.ts src/VehicleGeometry.test.ts src/atlas.test.ts src/regionTiles.test.ts",
    "tiles": "python tools/package_illustrated_expansion.py --out public/map && python tools/finalize_illustrated_expansion.py public/map"
  },
  "dependencies": {
    "openseadragon": "6.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/openseadragon": "3.0.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  }
}
